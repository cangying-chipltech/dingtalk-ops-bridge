# DingTalk robot connection. Set one of these two authentication methods.
DWS_UNIFIED_APP_ID=
ROBOT_CLIENT_ID=
ROBOT_CLIENT_SECRET=

# Optional command access control and dws flags.
DWS_ALLOWED_USERS=
DWS_ALLOWED_GROUPS=
DWS_NOTIFY_STAFF_ID=
DWS_EXTRA_ARGS=

# DingTalk custom robot webhook used for anomaly and recovery notifications.
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
DINGTALK_WEBHOOK_KEYWORD=
DINGTALK_ALERT_AT_MOBILES=
DINGTALK_WEBHOOK_TIMEOUT_SECONDS=10

# Plugin-specific settings and secrets are documented by each plugin.
# Examples: plugins/nodes/README.md, plugins/swe-runner/README.md

# Runtime tuning.
LOG_LEVEL=INFO
ACTION_MAX_CONCURRENCY=8
ACTION_MAX_OUTPUT_CHARS=3600
COMMAND_MAX_REPLY_CHARS=12000
# Optional; container default is /app/plugins, local default is ./plugins.
# ACTION_PLUGIN_DIR=/app/plugins
MONITOR_MAX_CONCURRENCY=8
MONITOR_DEFAULT_INTERVAL_SECONDS=60
MONITOR_MAX_OUTPUT_CHARS=4000
